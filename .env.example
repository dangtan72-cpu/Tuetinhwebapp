# Copy to .env and adjust for your environment
DATABASE_URL="postgresql://tuetinh:tuetinh_dev@localhost:5432/tuetinh?schema=public"

# LiveKit (optional — nếu trống, phòng học dùng Jitsi)
# Tạo project miễn phí tại https://cloud.livekit.io
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Thanh toán tuyển sinh (mock = demo; vnpay = VNPay thật)
PAYMENT_PROVIDER="mock"
# Production (phương án B):
# NEXT_PUBLIC_APP_URL="https://portal.yduoctuetinh.com.vn"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VNPay (khi PAYMENT_PROVIDER=vnpay)
# VNPAY_TMN_CODE=""
# VNPAY_HASH_SECRET=""
# VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# VNPAY_RETURN_URL="http://localhost:3000/tuyen-sinh/thanh-toan/thanh-cong"
# VNPAY_IPN_URL="https://your-domain.com/api/admissions/vnpay-ipn"
