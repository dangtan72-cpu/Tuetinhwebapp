// Prisma schema — Tuệ Tĩnh webapp

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum SessionStatus {
  scheduled
  live
  ended
}

enum MaterialType {
  pdf
  link
  video
}

enum AdmissionStatus {
  pending
  paid
  contacted
  accepted
  rejected
}

enum PaymentStatus {
  pending
  success
  failed
  cancelled
}

enum SubmissionStatus {
  submitted
  graded
  returned
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  studentId    String   @unique
  passwordHash String
  fullName     String
  program      String
  className    String
  cohort       String
  role         Role     @default(student)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teachingClasses OnlineClass[]  @relation("TeacherClasses")
  enrollments     Enrollment[]
  attendance      Attendance[]
  assignments     Assignment[]   @relation("AssignmentAuthor")
  submissions     Submission[]
  admissionApplication AdmissionApplication?
  adminLogs       AdminActionLog[]
}

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  summary    String
  payload    Json?
  createdAt  DateTime @default(now())
}

model OnlineClass {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  program     String
  description String   @default("")
  teacherId   String
  teacher     User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  sessions    ClassSession[]
  assignments Assignment[]
}

model Enrollment {
  id        String      @id @default(cuid())
  classId   String
  userId    String
  class     OnlineClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([classId, userId])
}

model ClassSession {
  id             String        @id @default(cuid())
  classId        String
  class          OnlineClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  title          String
  startsAt       DateTime
  endsAt         DateTime
  status         SessionStatus @default(scheduled)
  roomSlug       String
  note           String?
  whiteboardData Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  materials  SessionMaterial[]
  attendance Attendance[]
}

model SessionMaterial {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title     String
  type      MaterialType
  url       String
}

model Attendance {
  id        String       @id @default(cuid())
  sessionId String
  userId    String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedAt DateTime     @default(now())

  @@unique([sessionId, userId])
}

model AdmissionApplication {
  id              String          @id @default(cuid())
  refCode         String          @unique
  fullName        String
  idNumber        String
  phone           String
  email           String
  education       String
  level           String
  program         String
  status          AdmissionStatus @default(pending)
  admissionFee    Int             @default(500000)
  userId          String?         @unique
  user            User?           @relation(fields: [userId], references: [id])
  issuedStudentId String?
  adminNote       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  payments Payment[]
}

model SiteSettings {
  id               String   @id @default("default")
  name             String
  shortName        String
  tagline          String
  phone            String
  email            String
  address          String
  facebook         String   @default("")
  youtube          String   @default("")
  logoUrl          String
  logoIconUrl      String
  heroImageUrl     String
  aboutImageUrl    String
  admissionsImageUrl String
  aboutText        String   @default("")
  updatedAt        DateTime @updatedAt
}

model NewsArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  excerpt   String
  body      String   @default("")
  imageUrl  String
  published Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id           String   @id @default(cuid())
  classId      String
  class        OnlineClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("AssignmentAuthor", fields: [authorId], references: [id])
  title        String
  description  String   @default("")
  attachmentUrl String?
  maxScore     Float    @default(10)
  dueAt        DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String           @default("")
  fileUrl      String?
  status       SubmissionStatus @default(submitted)
  score        Float?
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
}

model Payment {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  amount        Int
  orderCode     String               @unique
  provider      String               @default("mock")
  status        PaymentStatus        @default(pending)
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

